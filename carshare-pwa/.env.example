# Copy this file to .env and fill in your own Supabase project's values.
# Leaving these unset makes the app run fully offline against the mock
# in-memory/localStorage data layer (src/data-access/mockDataStore.js) - useful
# for demos and for developing GUI/Business Logic Layer code before a real
# Supabase project (or its Postgres schema / RLS policies) is ready.
#
# Full setup walkthrough (schema, RLS policies, storage bucket): docs/SUPABASE-SETUP.md

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
