# Copy this file to .env and fill in your own Supabase project's values.
# Leaving these unset makes the app run fully offline against the mock
# in-memory/localStorage data layer (src/data-access/mockDataStore.js) - useful
# for demos and for developing GUI/Business Logic Layer code before a real
# Supabase project (or its Postgres schema / RLS policies) is ready.
#
# Full setup walkthrough (schema, RLS policies, storage bucket): docs/SUPABASE-SETUP.md

VITE_SUPABASE_URL= https://pnetstmovctfwqcumodx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY= sb_publishable_fItCMWQUEbVZIHl-avNp2g_WoYtycND

# Optional separate endpoint and browser-safe publishable key for Tumpang
# Guide Edge Functions. When unset, Guide uses the Supabase values above.
VITE_TUMPANG_GUIDE_EDGE_URL=
VITE_TUMPANG_GUIDE_EDGE_PUBLISHABLE_KEY=

# Browser-safe VAPID application-server public key. Obtain it from the pinned
# jsr:@negrel/webpush@0.5.0 VAPID key generation described in
# docs/SUPABASE-SETUP.md. This is public; its matching private JWK stays only
# in Supabase Edge Function secrets.
VITE_WEB_PUSH_PUBLIC_KEY=

# Browser-safe STUN override for one-to-one voice calls. When blank, the app
# uses Cloudflare's free public STUN endpoint. Production TURN credentials are
# issued dynamically by the authenticated m3-turn-credentials Edge Function;
# never add a TURN key, token, username, or credential to a VITE_ variable.
VITE_WEBRTC_STUN_URLS=

# Route preview key. Use a browser key restricted to:
#   1. Websites: localhost/deployed Let's Tumpang domains only
#   2. API: Maps Embed API only
# Keep this separate from every other Maps key. See docs/GOOGLE-MAPS-SETUP.md.
VITE_GOOGLE_MAPS_EMBED_API_KEY=AIzaSyDxPchQoDI9C75dVeX4bk0QVPuUeOzVQTE

# Confirmed-location key. Use a separate website-restricted browser key that
# authorizes only Maps JavaScript API, Places API (New), and Geocoding API.
# Production must remain disabled until 250-request daily hard quotas are
# confirmed for Autocomplete and Geocoding. Never authorize Routes, Dynamic
# Maps, Static Maps, or Street View on this key.
VITE_GOOGLE_MAPS_PLACES_API_KEY=AIzaSyDxPchQoDI9C75dVeX4bk0QVPuUeOzVQTE

# Dynamic Maps + private live-location rollout gate. Keep false while the
# Supabase migration, Edge Functions, Map ID, quota permit and smoke tests are
# being verified; set true for the Trip Mode experience.
VITE_GOOGLE_MAP_ID=5e8d391c8266b41925f8be1f
VITE_M2_LIVE_TRACKING_ENABLED=true
VITE_M2_SOS_ENABLED=false

# Edge Function secrets are configured with Supabase secrets, never as VITE_
# browser variables and never with real values in this file:
# GOOGLE_ROUTES_SERVER_KEY=
# M2_ROUTE_QUOTE_SECRET=
# M2_ROUTE_BACKFILL_SECRET=
# M2_ALLOWED_ORIGIN=       # exact app origin(s), comma-separated for local + production
# CLOUDFLARE_ACCOUNT_ID=              # Supabase Edge Function secret only
# CLOUDFLARE_AI_TOKEN=                # Supabase Edge Function secret only
# M3_TRANSLATION_ALLOWED_ORIGINS=      # comma-separated localhost + deployed origins
# CLOUDFLARE_TURN_KEY_ID=              # Supabase Edge Function secret only
# CLOUDFLARE_TURN_API_TOKEN=           # Supabase Edge Function secret only
# CLOUDFLARE_ANALYTICS_TOKEN=          # Supabase Edge Function secret only
# M3_TURN_ALLOWED_ORIGINS=              # comma-separated localhost + deployed origins
# M3_TURN_MONITOR_SECRET=               # Supabase Edge Function + Vault, never Vite
# M1_AVATAR_CHECK_ALLOWED_ORIGINS=      # comma-separated localhost + deployed origins
# SIGHTENGINE_API_USER=                 # required for m1-avatar-content-check (nudity/gore/offensive/OCR); see D039 for the Gemini -> Vision -> Sightengine provider history
# SIGHTENGINE_API_SECRET=               # paired with SIGHTENGINE_API_USER, from the same Sightengine account dashboard - keep both out of version control

# Keep the Module 6 fixture as the default for tests and offline demos. Set to
# `supabase` only after 024 is deployed and the live catalogue access policy is
# confirmed for the signed-in users who will use Destination Discovery.
VITE_DISCOVERY_DATA_SOURCE=supabase

# Module 2 moderation: Supabase Edge secrets ONLY, never VITE_*.
# Reuses CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_AI_TOKEN above and existing
# SIGHTENGINE_API_USER/SIGHTENGINE_API_SECRET. Do not copy real secrets here.
# M2_TEXT_MODERATION_ENABLED=false
# M2_TEXT_EVALUATED_POLICY=           # m2-content-v4 only after acceptance
# M2_PHOTO_MODERATION_ENABLED=false
# M2_CONTENT_CLEANUP_SECRET=          # must match the cleanup Vault secret
# Optional dedicated override pair: M2_CLOUDFLARE_ACCOUNT_ID/M2_CLOUDFLARE_API_TOKEN
