VITE_GOOGLE_MAPS_PLACES_API_KEY=
VITE_GOOGLE_MAP_ID=
VITE_M2_LIVE_TRACKING_ENABLED=false
VITE_M2_SOS_ENABLED=false
VITE_DISCOVERY_DATA_SOURCE=fixture
